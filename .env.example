# MSSQL (Neural Memory)
MSSQL_SERVER=127.0.0.1
MSSQL_DATABASE=NeuralMemory
MSSQL_USERNAME=SA
MSSQL_PASSWORD=your_password_here
MSSQL_DRIVER={ODBC Driver 18 for SQL Server}

# Perseus Vault plugin (plugins/perseus-vault)
# Required when memory.provider is set to "perseus-vault" in ~/.hermes/config.yaml
PERSEUS_VAULT_MCP_TOKEN=your_token_here
# PERSEUS_VAULT_URL=https://vault.perseus.observer/message
# PERSEUS_VAULT_WORKSPACE=
